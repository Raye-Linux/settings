<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Raye Linux</vendor>
  <action id="org.raye.settings.signin">
    <description>Change the picture on the sign-in screen</description>
    <description xml:lang="fr">Changer l'image de l'écran de connexion</description>
    <message>Changing the picture on the sign-in screen needs root access</message>
    <message xml:lang="fr">Changer l'image de l'écran de connexion demande l'accès root</message>
    <!-- the user's own password if they are a sudo user, asked once for a few minutes -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/raye-settings/signin-background</annotate>
  </action>
</policyconfig>
