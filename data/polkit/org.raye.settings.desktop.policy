<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Raye Linux</vendor>
  <action id="org.raye.settings.desktop">
    <description>Choose the desktop you sign in to</description>
    <description xml:lang="fr">Choisir le bureau de votre session</description>
    <message>Changing the desktop you sign in to needs root access</message>
    <message xml:lang="fr">Changer le bureau de votre session demande l'accès root</message>
    <!-- the person at the PC can already pick it on the sign-in screen,
         and the helper only ever changes their own account: no password -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/raye-settings/desktop-session</annotate>
  </action>
</policyconfig>
