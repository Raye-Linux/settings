#!/bin/sh
# Accounts > Sign-in options > Sign in automatically. Writes which account
# the sign-in screen opens by itself, or takes that back. Run through
# pkexec (org.raye.settings.autologin), and only ever for the person who
# asked: the account comes from PKEXEC_UID, never from the command line.
#
#   autologin on        sign in as me without asking
#   autologin off       ask for my password again
#   autologin --check   say what is set now, change nothing
set -u

dir=/etc/sddm.conf.d
system=/usr/lib/sddm/sddm.conf.d
main=/etc/sddm.conf
sessions=/usr/share/wayland-sessions
sddm_home=$(getent passwd sddm | cut -d: -f6)
# the tests point them at folders of their own; never under pkexec
if [ -z "${PKEXEC_UID:-}" ]; then
    dir=${RAYE_SDDM_CONF_DIR:-$dir}
    system=${RAYE_SDDM_SYSTEM_DIR:-$system}
    main=${RAYE_SDDM_MAIN:-$main}
    sessions=${RAYE_SESSION_DIR:-$sessions}
    sddm_home=${RAYE_SDDM_HOME:-$sddm_home}
fi
# read after every file the packages install in that folder
file=$dir/zz-raye-autologin.conf

# Who SDDM signs in: the system folder, then /etc/sddm.conf.d, then
# /etc/sddm.conf, each folder in name order; the last User= wins.
effective() {
    set --
    for d in "$system" "$dir"; do
        [ -d "$d" ] || continue
        for f in "$d"/*.conf; do
            [ -f "$f" ] && set -- "$@" "$f"
        done
    done
    [ -f "$main" ] && set -- "$@" "$main"
    [ $# -gt 0 ] || return 0
    awk '
        { sub(/\r$/, ""); line = $0; gsub(/^[ \t]+|[ \t]+$/, "", line) }
        line ~ /^\[/ { section = line; next }
        section == "[Autologin]" && line ~ /^User[ \t]*=/ {
            sub(/^User[ \t]*=[ \t]*/, "", line); user = line
        }
        END { print user }
    ' "$@"
}

# the desktop this account signs in to: what Personalization > Desktop
# environment or the sign-in screen last chose for it
# (~sddm/.config/raye-signin.conf), Plasma when nothing was chosen
session_of() {
    chosen=$(awk -v k="$1" '
        { sub(/\r$/, ""); line = $0; gsub(/^[ \t]+|[ \t]+$/, "", line) }
        line ~ /^\[/ { inside = (line == "[sessions]"); next }
        inside && index(line, k "=") == 1 { v = substr(line, length(k) + 2) }
        END { print v }
    ' "$sddm_home/.config/raye-signin.conf" 2>/dev/null)
    case $chosen in
    raye-hyprland.desktop)
        if [ -f "$sessions/$chosen" ]; then echo "$chosen"; return; fi ;;
    esac
    echo plasma
}

write() { # the file we own, with this User= (empty: nobody)
    mkdir -p "$dir" || exit 1
    tmp=$file.new
    umask 022
    {
        printf '# Written by Settings > Accounts > Sign-in options.\n'
        if [ -n "$1" ]; then
            printf '[Autologin]\nUser=%s\nSession=%s\nRelogin=false\n' "$1" "$(session_of "$1")"
        else
            printf '[Autologin]\nUser=\n'
        fi
    } > "$tmp" || exit 1
    mv -f "$tmp" "$file" || exit 1
}

# what was asked has to be what SDDM now reads, or it failed
verify() {
    now=$(effective)
    [ "$now" = "$1" ] && return 0
    echo "autologin: set in $main, which is read last" >&2
    exit 4
}

case ${1:-} in
on)
    uid=${PKEXEC_UID:-${RAYE_TEST_UID:-}}
    case $uid in
    ''|*[!0-9]*) echo "autologin: run me through pkexec" >&2; exit 2 ;;
    0) echo "autologin: not for the root account" >&2; exit 2 ;;
    esac
    login=$(getent passwd "$uid" | cut -d: -f1)
    [ -n "$login" ] || { echo "autologin: no account for uid $uid" >&2; exit 3; }
    write "$login"
    if [ "$(effective)" != "$login" ]; then
        rm -f "$file"
        verify "$login"
    fi
    ;;
off)
    rm -f "$file" || exit 1
    # another file still signs someone in: ours, read after it, says nobody
    [ -z "$(effective)" ] || write ""
    verify ""
    ;;
--check)
    effective
    ;;
*)
    echo "usage: autologin on|off|--check" >&2
    exit 2
    ;;
esac
exit 0
