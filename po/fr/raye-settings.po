msgctxt "@label a protection that is on"
msgid "On"
msgstr "Activé"

msgctxt "@label a protection that is off"
msgid "Off"
msgstr "Désactivé"

msgctxt "@label"
msgid "Not available"
msgstr "Non disponible"

msgctxt "@label"
msgid "Disk encryption"
msgstr "Chiffrement du disque"

msgctxt "@info"
msgid "Off. Someone who takes the disk out of this PC can read your files. Encryption is chosen when Raye is installed."
msgstr "Désactivé. Quelqu'un qui retire le disque de ce PC peut lire vos fichiers. Le chiffrement se choisit à l'installation de Raye."

msgctxt "@info"
msgid "On. The disk asks for its password at start-up until the security chip is set up again."
msgstr "Activé. Le disque demande son mot de passe au démarrage jusqu'à ce que la puce de sécurité soit configurée de nouveau."

msgctxt "@info"
msgid "On. The security chip unlocks the disk when the PC starts; its password works too."
msgstr "Activé. La puce de sécurité déverrouille le disque au démarrage du PC ; son mot de passe fonctionne aussi."

msgctxt "@info"
msgid "On. The disk asks for its password when the PC starts."
msgstr "Activé. Le disque demande son mot de passe au démarrage du PC."

msgctxt "@label"
msgid "Turning it on"
msgstr "Activation"

msgctxt "@info"
msgid "Encryption can only be turned on when Raye is installed. Back up your files, then reinstall Raye and choose to encrypt the disk."
msgstr "Le chiffrement ne peut être activé qu'à l'installation de Raye. Sauvegardez vos fichiers, puis réinstallez Raye et choisissez de chiffrer le disque."

msgctxt "@label"
msgid "Unlocking"
msgstr "Déverrouillage"

msgctxt "@info"
msgid "With the disk password, each time the PC starts."
msgstr "Avec le mot de passe du disque, à chaque démarrage du PC."

msgctxt "@info"
msgid "With the disk password, until the security chip is set up again."
msgstr "Avec le mot de passe du disque, jusqu'à ce que la puce de sécurité soit configurée de nouveau."

msgctxt "@info"
msgid "By the security chip, without a password, as long as nothing changed in how the PC starts."
msgstr "Par la puce de sécurité, sans mot de passe, tant que rien n'a changé dans la façon dont le PC démarre."

msgctxt "@info"
msgid "By the security chip when it can, otherwise with the disk password."
msgstr "Par la puce de sécurité quand c'est possible, sinon avec le mot de passe du disque."

msgctxt "@label"
msgid "Disk asks for its password again?"
msgstr "Le disque redemande son mot de passe ?"

msgctxt "@info"
msgid "Let the security chip open the disk by itself again. You need the disk password once."
msgstr "Laisser la puce de sécurité ouvrir de nouveau le disque toute seule. Le mot de passe du disque vous sera demandé une fois."

msgctxt "@action:button"
msgid "Use the security chip again"
msgstr "Utiliser de nouveau la puce de sécurité"

msgctxt "@label"
msgid "Recovery key"
msgstr "Clé de récupération"

